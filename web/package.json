{
  "name": "tillbox-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.json && vite build",
    "postbuild": "node -e \"require('fs').writeFileSync('../internal/webui/dist/.gitkeep', '')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.23.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@number-flow/react": "0.6.2",
    "@react-aria/utils": "3.34.1",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@yreidev/ui": "0.1.2",
    "dayjs": "1.11.23",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.11.2",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uqr": "0.1.3",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.46",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
